# OwnRAG engine configuration. Copy to `.env` and edit. Never commit the real file.
#
# Nothing in here is required: with no models configured the engine still parses, chunks, indexes
# and retrieves your documents for real, and answers extractively from the retrieved passages.

# ---- server ----
# OWNRAG_HOST=127.0.0.1
# OWNRAG_PORT=9380
# OWNRAG_DATA_DIR=./data
# Browser origins allowed to call the API (the console's own origin). Comma-separated.
# OWNRAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- accounts -------------------------------------------------------------
# The owner account is created on first start. On loopback it signs in with no password; anywhere
# else the engine REFUSES TO START unless OWNRAG_OWNER_PASSWORD is set, so a network-exposed engine
# can never be passwordless.
# OWNRAG_OWNER_EMAIL=owner@ownrag.local
# OWNRAG_OWNER_PASSWORD=

# Anyone can then create their own account from the console's sign-up screen. Passwords are stored
# as scrypt hashes. Set this to 0 to close the deployment to new accounts while keeping existing
# ones — the owner account is unaffected and can still sign in.
# OWNRAG_ALLOW_SIGNUP=1

# How long a session (API token) stays valid. Each sign-in gets its own token, revoked individually
# by POST /api/v1/auth/logout; expired tokens are rejected on use and pruned at startup.
# OWNRAG_TOKEN_TTL_DAYS=30

# Failed sign-ins allowed per account/address pair inside 15 minutes before that pair is locked for
# 15 minutes. Counted per process, so run a single worker if you rely on it.
# OWNRAG_MAX_LOGIN_FAILURES=5

# Hard ceiling on an uploaded file. Enforced while the body is streamed, and reported to the
# console as system/config maxFileSize — a rejected upload leaves nothing on disk.
# OWNRAG_MAX_UPLOAD_MB=256

# ---- generations and embeddings (both optional, both overridden by the console) ----
# The normal way to bring a model is the console's Models screen: add a provider, paste its API
# base and key, and enable the models you want. That takes effect on the next question, with no
# restart, and it is what the engine selects first. The variables below are the deployment-level
# default, used only when no provider is enabled in the console.
#
# Any OpenAI-compatible /chat/completions endpoint: OpenAI, DeepSeek, OpenRouter, vLLM, Ollama,
# LM Studio. When one is in play, answers are generated and grounded on your retrieved passages.
# OWNRAG_LLM_BASE_URL=https://api.deepseek.com/v1
# OWNRAG_LLM_API_KEY=
# OWNRAG_LLM_MODEL=deepseek-chat

# Any OpenAI-compatible /embeddings endpoint. When set, semantic vectors replace the built-in
# lexical ones, and the engine reports which encoder every chunk was embedded with. Changing the
# encoder marks existing vectors stale rather than mixing incompatible spaces — re-ingest to
# re-embed them; GET /api/v1/datasets/{id}/embedding/check says exactly which chunks are behind.
# OWNRAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OWNRAG_EMBEDDING_API_KEY=
# OWNRAG_EMBEDDING_MODEL=text-embedding-3-small

# ---- chunking defaults ----
# OWNRAG_CHUNK_SIZE=512
# OWNRAG_CHUNK_OVERLAP=80

# ---- built-in lexical vector width (only used when no embedding endpoint is configured) ----
# OWNRAG_LOCAL_EMBED_DIM=768
